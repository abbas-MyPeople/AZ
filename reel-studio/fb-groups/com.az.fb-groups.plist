<?xml version="1.0" encoding="UTF-8"?>
<!-- AZ: one post a day into a restaurant-owner Facebook group, and a watch on the replies
     (reel-studio/fb-groups/az_fb_groups.py). Runs at login, on wake (launchd runs a missed time once) and every 2 hours 9:05 AM to 11:05 PM. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.az.fb-groups</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/abbaspersonal/Library/Application Support/az-fb-groups/az_fb_groups.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>5</integer></dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>/Users/abbaspersonal/Library/Logs/az-fb-groups.log</string>
  <key>StandardErrorPath</key><string>/Users/abbaspersonal/Library/Logs/az-fb-groups.log</string>
</dict>
</plist>
